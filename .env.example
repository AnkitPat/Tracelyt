# Local databases from docker compose.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracelyt
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=tracelyt
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tracelyt

# Dev project created by `pnpm seed`. The API key is printed once and written to frontend/.env.local.
TRACELYT_API_URL=http://localhost:4000
TRACELYT_PROJECT_ID=00000000-0000-4000-8000-000000000002
TRACELYT_API_KEY=

# Read by the Next.js server when proxying the dashboard. Defaults match the values above.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROJECT_ID=00000000-0000-4000-8000-000000000002
